{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/", "destination": "/index.html" },
    { "source": "/en/pricing", "destination": "/bang-gia/index.html" },
    { "source": "/en/pricing/", "destination": "/bang-gia/index.html" },
    { "source": "/en/download", "destination": "/tai-xuong/index.html" },
    { "source": "/en/download/", "destination": "/tai-xuong/index.html" },
    { "source": "/en/about", "destination": "/gioi-thieu/index.html" },
    { "source": "/en/about/", "destination": "/gioi-thieu/index.html" },
    { "source": "/en/policies", "destination": "/chinh-sach/index.html" },
    { "source": "/en/policies/", "destination": "/chinh-sach/index.html" },
    { "source": "/en/policies/privacy", "destination": "/chinh-sach/bao-mat/index.html" },
    { "source": "/en/policies/privacy/", "destination": "/chinh-sach/bao-mat/index.html" },
    { "source": "/en/policies/terms", "destination": "/chinh-sach/dieu-khoan/index.html" },
    { "source": "/en/policies/terms/", "destination": "/chinh-sach/dieu-khoan/index.html" },
    { "source": "/en/policies/cookies", "destination": "/chinh-sach/cookie/index.html" },
    { "source": "/en/policies/cookies/", "destination": "/chinh-sach/cookie/index.html" },
    { "source": "/en/policies/refunds", "destination": "/chinh-sach/thanh-toan-hoan-tien/index.html" },
    { "source": "/en/policies/refunds/", "destination": "/chinh-sach/thanh-toan-hoan-tien/index.html" },
    { "source": "/en/policies/licenses", "destination": "/chinh-sach/giay-phep/index.html" },
    { "source": "/en/policies/licenses/", "destination": "/chinh-sach/giay-phep/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
