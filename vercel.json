{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/en",
      "destination": "/index.html"
    },
    {
      "source": "/en/",
      "destination": "/index.html"
    },
    {
      "source": "/en/pricing",
      "destination": "/bang-gia/index.html"
    },
    {
      "source": "/en/pricing/",
      "destination": "/bang-gia/index.html"
    },
    {
      "source": "/en/download",
      "destination": "/tai-xuong/index.html"
    },
    {
      "source": "/en/download/",
      "destination": "/tai-xuong/index.html"
    },
    {
      "source": "/en/about",
      "destination": "/gioi-thieu/index.html"
    },
    {
      "source": "/en/about/",
      "destination": "/gioi-thieu/index.html"
    },
    {
      "source": "/en/policies",
      "destination": "/chinh-sach/index.html"
    },
    {
      "source": "/en/policies/",
      "destination": "/chinh-sach/index.html"
    },
    {
      "source": "/en/policies/privacy",
      "destination": "/chinh-sach/bao-mat/index.html"
    },
    {
      "source": "/en/policies/privacy/",
      "destination": "/chinh-sach/bao-mat/index.html"
    },
    {
      "source": "/en/policies/terms",
      "destination": "/chinh-sach/dieu-khoan/index.html"
    },
    {
      "source": "/en/policies/terms/",
      "destination": "/chinh-sach/dieu-khoan/index.html"
    },
    {
      "source": "/en/policies/cookies",
      "destination": "/chinh-sach/cookie/index.html"
    },
    {
      "source": "/en/policies/cookies/",
      "destination": "/chinh-sach/cookie/index.html"
    },
    {
      "source": "/en/policies/refunds",
      "destination": "/chinh-sach/thanh-toan-hoan-tien/index.html"
    },
    {
      "source": "/en/policies/refunds/",
      "destination": "/chinh-sach/thanh-toan-hoan-tien/index.html"
    },
    {
      "source": "/en/policies/licenses",
      "destination": "/chinh-sach/giay-phep/index.html"
    },
    {
      "source": "/en/policies/licenses/",
      "destination": "/chinh-sach/giay-phep/index.html"
    },
    {
      "source": "/en/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/en/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/en/blog/photos-look-different-on-facebook",
      "destination": "/blog/anh-dang-facebook-bi-lech-mau/index.html"
    },
    {
      "source": "/en/blog/photos-look-different-on-facebook/",
      "destination": "/blog/anh-dang-facebook-bi-lech-mau/index.html"
    },
    {
      "source": "/en/login",
      "destination": "/dang-nhap/index.html"
    },
    {
      "source": "/en/login/",
      "destination": "/dang-nhap/index.html"
    },
    {
      "source": "/en/orders",
      "destination": "/don-hang/index.html"
    },
    {
      "source": "/en/orders/",
      "destination": "/don-hang/index.html"
    },
    {
      "source": "/v1/t/:file",
      "destination": "/cache_t/:file"
    },
    {
      "source": "/__api/v1/t/:file",
      "destination": "/cache_t/:file"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/accounts",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/accounts/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/notifications",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/notifications/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/keys",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/keys/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/orders",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/orders/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/promo",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/promo/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/bugs",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/bugs/",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(native-models\\.json|prep\\.json)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(vendor|hptul|cache_t|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}